<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Npgsql 10.0.3 is supplied by the approved local NuGet global-packages cache. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
